import Mathlib.Data.Matrix.Basic
import Mathlib.Basic.Complex.Basic

/-! Frozen definition `def_step_v1` (see `lean/frozen-manifest.json`). Do not edit: a change
needs an author-approved versioned successor. Source: Paper A, transfer.tex lines 11–26, as
restricted to piecewise-constant histories by author ruling R1(a) (docs/DECISIONS.md, D11). -/

namespace QEDCore.PaperA

/-- One step of an ordered history (Paper A, Lemma 3.1): a free evolution of duration `τ`
generated by `Σ_j α_j v_j + β M` with spatial coefficients `v` and mass matrix `M`, or a
spin-scalar kick `exp (i Θ)` with spatial generator `Θ`. -/
inductive Step (ι : Type*) where
  | free (τ : ℝ) (v : Fin 3 → Matrix ι ι ℂ) (M : Matrix ι ι ℂ)
  | kick (Θ : Matrix ι ι ℂ)

end QEDCore.PaperA
